target lit {
    compiler = gcc
    standard = c11
    optimization = -O3
    flags = [
        -Wall,
        -Wextra
    ]
    sources [
        main.c,
        engine.c,
        start.c,
        save.c,
        status.c,
        history.c,
        branch.c,
        push.c,
        ignite.c,
        dalek.c,
        dilute.c,
        nuke.c,
        flags.c,
        grep.c,
        help.c,
        checkout.c,
        stash.c,
        cat.c,
        reverse.c
    ]
    install_path = /usr/local/bin/lit
}